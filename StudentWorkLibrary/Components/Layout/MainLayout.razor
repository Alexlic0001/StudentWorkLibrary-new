@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/">📚 Библиотека студенческих работ</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">Главная</a>
                </li>
                @if (isAuthenticated && isAdmin)
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/admin/upload">📤 Загрузить работу</a>
                    </li>
                }
                @if (isAuthenticated)
                {
                    <li class="nav-item">
                        <span class="nav-link text-info">👤 @userEmail</span>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-outline-danger btn-sm ms-2" @onclick="Logout">Выйти</button>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn btn-outline-primary btn-sm ms-2" href="/login">Войти</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container mt-3">
    @Body
</main>

<footer class="border-top footer text-muted mt-4">
    <div class="container">
        &copy; 2024 - Библиотека студенческих работ
    </div>
</footer>

<style>
    .footer {
        position: absolute;
        bottom: 0;
        width: 100%;
        white-space: nowrap;
        line-height: 60px;
    }

    html {
        position: relative;
        min-height: 100%;
    }

    body {
        margin-bottom: 60px;
    }
</style>

@code {
    private bool isAuthenticated = false;
    private bool isAdmin = false;
    private string userEmail = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAuthenticated = user.Identity?.IsAuthenticated ?? false;

        if (isAuthenticated)
        {
            userEmail = user.Identity?.Name ?? "";
            isAdmin = user.IsInRole("Admin");
        }

        AuthProvider.AuthenticationStateChanged += async _ =>
        {
            await InvokeAsync(async () =>
            {
                var newState = await AuthProvider.GetAuthenticationStateAsync();
                var newUser = newState.User;
                isAuthenticated = newUser.Identity?.IsAuthenticated ?? false;
                userEmail = newUser.Identity?.Name ?? "";
                isAdmin = newUser.IsInRole("Admin");
                StateHasChanged();
            });
        };
    }

    private void Logout()
    {
        Navigation.NavigateTo("/logout", true);
    }
}